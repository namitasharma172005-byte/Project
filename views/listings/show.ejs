<% layout("layouts/boilerplate") %>

<!-- FLASH MESSAGES -->
<% if(success && success.length > 0){ %>
  <div class="alert alert-success">
    <%= success[0] %>
  </div>
<% } %>

<% if(error && error.length > 0){ %>
  <div class="alert alert-danger">
    <%= error[0] %>
  </div>
<% } %>

<div class="container mt-4">
  <div class="row">
    <div class="col-md-8 mx-auto">

      <h3><%= listing.title %></h3>

      <div class="card mx-auto show-card listing-card" style="width: 30rem;">
        
        <% let imageUrl = listing.image && listing.image.url 
           ? listing.image.url 
           : "/images/default.jpg"; %>

        <img 
          src="<%= imageUrl %>" 
          class="card-img-top show-img" 
          alt="listing_image"
          style="height:20rem; object-fit:cover;"
        />

        <div class="card-body">
          <p class="card-text">
            <%= listing.description %><br>
            &#8377 <%= Number(listing.price).toLocaleString("en-IN") %><br>
            <%= listing.location %><br>
            <%= listing.country %>
          </p>
        </div>
      </div>

      <% if(currUser) { %>
        <div class="d-flex justify-content-center gap-3 mt-3">
          
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">
            Edit
          </a>

          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
            <button class="btn btn-danger">
              Delete
            </button>
          </form>

        </div>
      <% } else { %>
        <p class="text-center mt-3 text-muted">
          Please login to edit or delete this listing
        </p>
      <% } %>

      <!-- REVIEW SECTION -->
      <div class="mt-4">
        <hr>

        <h5>Leave a Review</h5>

        <% if(currUser) { %>

          <form 
            method="POST"
            action="/listings/<%= listing._id %>/reviews"
            novalidate
            class="needs-validation"
          >

            
            <fieldset class="starability-slot mb-3">
              <legend>Rating:</legend>

              <input type="radio" id="rate1" name="review[rating]" value="1" required />
              <label for="rate1">1 star</label>

              <input type="radio" id="rate2" name="review[rating]" value="2" />
              <label for="rate2">2 stars</label>

              <input type="radio" id="rate3" name="review[rating]" value="3" />
              <label for="rate3">3 stars</label>

              <input type="radio" id="rate4" name="review[rating]" value="4" />
              <label for="rate4">4 stars</label>

              <input type="radio" id="rate5" name="review[rating]" value="5" />
              <label for="rate5">5 stars</label>
            </fieldset>

            <!-- COMMENT -->
            <div class="mb-3">
              <label for="comment" class="form-label">Comments</label>
              <textarea 
                name="review[comment]"
                id="comment"
                class="form-control"
                required
              ></textarea>

              <div class="invalid-feedback">
                Please submit valid feedback.
              </div>
            </div>

            <button class="btn btn-outline-dark">Submit</button>
          </form>

        <% } else { %>
          <p class="text-muted">Login to leave a review.</p>
        <% } %>

        <hr>

        <p><b>All Reviews</b></p>

        <div class="row">

          <% if(listing.reviews && listing.reviews.length > 0) { %>

            <% for(let review of listing.reviews){ %>

              <div class="col-md-6 mb-2">
                <div class="card">
                  <div class="card-body">

                    <h5 class="card-title">Anonymous</h5>

                    <p class="card-text">
                      <%= review.comment %>
                    </p>

                    <!-- ⭐ SHOW RATING -->
                    <p class="starability-result" data-rating="<%= review.rating %>">
                      Rated: <%= review.rating %> stars
                    </p>

                    <% if(currUser && review.author.equals(currUser._id)) { %>
                      <form 
                        method="POST"
                        action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                      >
                        <button type="submit" class="btn btn-sm btn-danger">
                          Delete
                        </button>
                      </form>
                    <% } %>

                  </div>
                </div>
              </div>

            <% } %>

          <% } else { %>
            <p>No reviews yet.</p>
          <% } %>

        </div>

      </div>

    </div>
  </div>
</div>